    },
    {
      "code": "A: B: C: D: 'foo'",
      "valid": false
    },
    {
      "code": "A: B: C: D: E: 'foo'",
      "valid": false
    },
    {
      "code": "A: 42",
      "valid": false
    },
    {
      "code": "A: { function f() { B: { } } break A; }",
