    },
    {
      "code": "var foo = () =\u003e {}; foo = bar;",
      "valid": true
    },
    {
      "code": "var foo = function() {}; foo = bar;",
      "valid": true
    },
    {
      "code": "var foo = function() { foo = bar; };",
      "valid": true
    },
    {
      "code": "import bar from 'bar'; function foo() { var foo = bar; }",
      "valid": true
    },
    {
