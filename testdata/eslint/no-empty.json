{
  "ruleId": "no-empty",
  "oxcSHA": "625758ab25657c0fc13555c890aeca979be8ebdf",
  "oxcSource": "crates/oxc_linter/src/rules/eslint/no_empty.rs",
  "cases": [
    {
      "code": "if (foo) { bar() }",
      "valid": true
    },
    {
      "code": "while (foo) { bar() }",
      "valid": true
    },
    {
      "code": "for (;foo;) { bar() }",
      "valid": true
    },
    {
      "code": "try { foo() } catch (ex) { foo() }",
      "valid": true
    },
    {
      "code": "switch(foo) {case 'foo': break;}",
      "valid": true
    },
    {
      "code": "(function() { }())",
      "valid": true
    },
    {
      "code": "var foo = () =\u003e {};",
      "valid": true
    },
    {
      "code": "function foo() { }",
      "valid": true
    },
    {
      "code": "if (foo) {/* empty */}",
      "valid": true
    },
    {
      "code": "while (foo) {/* empty */}",
      "valid": true
    },
    {
      "code": "for (;foo;) {/* empty */}",
      "valid": true
    },
    {
      "code": "try { foo() } catch (ex) {/* empty */}",
      "valid": true
    },
    {
      "code": "try { foo() } catch (ex) {// empty\n}",
      "valid": true
    },
    {
      "code": "try { foo() } finally {// empty\n}",
      "valid": true
    },
    {
      "code": "try { foo() } finally {// test\n}",
      "valid": true
    },
    {
      "code": "try { foo() } finally {\n \n // hi i am off no use\n}",
      "valid": true
    },
    {
      "code": "try { foo() } catch (ex) {/* test111 */}",
      "valid": true
    },
    {
      "code": "if (foo) { bar() } else { // nothing in me \n}",
      "valid": true
    },
    {
      "code": "if (foo) { bar() } else { /**/ \n}",
      "valid": true
    },
    {
      "code": "if (foo) { bar() } else { // \n}",
      "valid": true
    },
    {
      "code": "try { foo(); } catch (ex) {}",
      "valid": true,
      "options": [
        {
          "allowEmptyCatch": true
        }
      ]
    },
    {
      "code": "try { foo(); } catch (ex) {} finally { bar(); }",
      "valid": true,
      "options": [
        {
          "allowEmptyCatch": true
        }
      ]
    },
    {
      "code": "try {} catch (ex) {throw ex}",
      "valid": false
    },
    {
      "code": "try { foo() } catch (ex) {throw ex} finally {}",
      "valid": false
    },
    {
      "code": "try { foo() } catch (ex) {}",
      "valid": false
    },
    {
      "code": "if (foo) {}",
      "valid": false
    },
    {
      "code": "while (foo) {}",
      "valid": false
    },
    {
      "code": "for (;foo;) {}",
      "valid": false
    },
    {
      "code": "switch(foo) {}",
      "valid": false
    },
    {
      "code": "switch (foo) { /* empty */ }",
      "valid": false
    },
    {
      "code": "try {} catch (ex) {}",
      "valid": false,
      "options": [
        {
          "allowEmptyCatch": true
        }
      ]
    },
    {
      "code": "try { foo(); } catch (ex) {} finally {}",
      "valid": false,
      "options": [
        {
          "allowEmptyCatch": true
        }
      ]
    },
    {
      "code": "try {} catch (ex) {} finally {}",
      "valid": false,
      "options": [
        {
          "allowEmptyCatch": true
        }
      ]
    },
    {
      "code": "try { foo(); } catch (ex) {} finally {}",
